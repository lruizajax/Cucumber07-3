<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite de Automatización E-commerce" verbose="1" parallel="tests" thread-count="6">

    <!-- 1. Registro -->
    <test name="Registro de nuevos usuarios">
        <parameter name="cucumber.filter.tags" value="@registro"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

    <!-- 2. Sesión -->
    <test name="Inicio de sesión">
        <parameter name="cucumber.filter.tags" value="@sesion"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

    <!-- 3. Carrito -->
    <test name="Carrito de compras">
        <parameter name="cucumber.filter.tags" value="@car"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

    <!-- 4. Checkout -->
    <test name="Checkout">
        <parameter name="cucumber.filter.tags" value="@checkout"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

    <!-- 5. Órdenes -->
    <test name="Gestión de órdenes">
        <parameter name="cucumber.filter.tags" value="@order"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

    <!-- 6. Perfil -->
    <test name="Perfil de usuario">
        <parameter name="cucumber.filter.tags" value="@profile"/>
        <classes>
            <class name="com.magento.runner.TestRunner"/>
        </classes>
    </test>

</suite>